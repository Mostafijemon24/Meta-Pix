# Public site URL (no trailing slash) — used for SEO canonicals + OpenRouter referer
NEXT_PUBLIC_SITE_URL=https://meta-pix-mauve.vercel.app

# OpenRouter free API key — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx

# Optional: pin a free vision model. Default routes via openrouter/free
# OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_MODEL=openrouter/free
